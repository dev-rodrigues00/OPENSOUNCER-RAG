# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/enterprise_rag_db

# Embedding Provider Configuration: 'openai' | 'ollama'
EMBEDDING_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Ollama Configuration (Local / On-Premise)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_CHAT_MODEL=llama3.1

# RAG & Retriever Parameters
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.75
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
